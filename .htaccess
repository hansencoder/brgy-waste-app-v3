RewriteEngine On

Options -Indexes

<FilesMatch "\.(json|log|ini|sql|config|bak|md|env)$">
    Require all denied
</FilesMatch>       

<Files ".htaccess">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Transparently support legacy subfolder paths on live domains
RewriteRule ^brgy-waste-app-v3/public/(.*)$ public/$1 [L]
RewriteRule ^brgy-waste-app-v3/(.*)$ public/$1 [L]

# Handle static uploads & assets directly
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^images/(.*)$ public/images/$1 [L]
RewriteRule ^css/(.*)$ public/css/$1 [L]
RewriteRule ^js/(.*)$ public/js/$1 [L]

# Redirect root requests to public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]